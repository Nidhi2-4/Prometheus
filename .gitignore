# ==========================================
# Swasthik - Root .gitignore
# ==========================================

# OS & System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment & Secret files
.env
.env.*
env.local
*.local
!.env.example
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision

# Node / Frontend / Expo
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo
frontend/ios/
frontend/android/
.kotlin/
*.orig.*

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ML Data & Temporary Media
*.mp4
*.m4a
*.wav
*.avi
*.mov
tmp/
temp/
uploads/
ml/data/raw/
ml/data/processed/

# IDE & Editor files
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Real env values per target (secrets): never commit
env.local
env.render
env.vercel
